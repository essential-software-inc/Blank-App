{
  "name": "note-builder",
  "version": "3.2.9",
  "private": true,
  "description": "Note Builder — wrapped as an iOS/Android app with Capacitor",
  "scripts": {
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:doctor": "cap doctor",
    "capacitor:sync:before": "python3 scripts/patch-ad-attest-client.py --skip-missing www/index.html",
    "capacitor:sync:after": "python3 scripts/add-play-integrity.py"
  },
  "dependencies": {
    "@capacitor/core": "latest",
    "@capacitor/app": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/inappbrowser": "latest",
    "@capacitor/share": "latest",
    "@southdevs/capacitor-google-auth": "latest",
    "@revenuecat/purchases-capacitor": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/ios": "latest",
    "@capacitor/android": "latest",
    "typescript": "latest"
  }
}
